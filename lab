#!/usr/bin/env bash
# WP Break/Fix Lab: break a real WordPress site, then prove you can fix it.
set -euo pipefail

# shellcheck source=lib/common.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh"

usage() {
  cat <<EOF
Usage: ./lab <command>

  list               Show available scenarios
  start <scenario>   Reset the site, break it, and show the support ticket
  check              Grade your fix for the current scenario
  ticket             Show the current ticket again
  reset              Rebuild a clean, working site
  down               Stop everything and delete the lab's data

Tools while you work:
  wp <args>          Run WP-CLI (e.g. ./lab wp plugin list)
  shell              Open a shell in the PHP container
  logs [service]     Show container logs (wordpress, nginx, db)

Site: $LAB_URL   (admin / admin)
EOF
}

current_scenario() {
  [[ -f "$LAB_STATE/scenario" ]] || die "No scenario running. Try: ./lab list"
  cat "$LAB_STATE/scenario"
}

scenario_dir() {
  local dir="$LAB_ROOT/scenarios/$1"
  [[ -f "$dir/break.sh" && -f "$dir/check.sh" ]] || die "Unknown scenario '$1'. Try: ./lab list"
  echo "$dir"
}

cmd_list() {
  local d
  for d in "$LAB_ROOT"/scenarios/*/; do
    printf '  %-18s %s\n' "$(basename "$d")" "$(head -n1 "$d/ticket.md" | sed 's/^# *//')"
  done
}

# Bring up a clean, installed WordPress.
cmd_reset() {
  echo "Building a clean site..."
  compose --profile tools down -v --remove-orphans >/dev/null 2>&1 || true
  find "$LAB_ROOT/nginx/lab" -type f ! -name .gitkeep -delete
  rm -rf "$LAB_STATE"; mkdir -p "$LAB_STATE"
  compose up -d --wait >/dev/null

  # The PHP container copies WordPress into the volume on first boot; wait for it.
  local i
  for i in $(seq 1 60); do
    in_php 'test -f /var/www/html/wp-config.php' 2>/dev/null && break
    sleep 1
    [[ $i -eq 60 ]] && die "WordPress files never appeared. Check: ./lab logs wordpress"
  done

  wp core install --url="$LAB_URL" --title="Break/Fix Lab" \
    --admin_user=admin --admin_password=admin --admin_email=admin@example.com \
    --skip-email >/dev/null
  wp rewrite structure '/%postname%/' >/dev/null

  [[ "$(http_code /)" == 200 ]] || die "Clean site isn't returning 200. Check: ./lab logs"
  echo "Clean site is up at $LAB_URL"
}

cmd_start() {
  [[ $# -eq 1 ]] || die "Usage: ./lab start <scenario>"
  local dir; dir="$(scenario_dir "$1")"
  cmd_reset
  echo "Breaking things..."
  bash "$dir/break.sh" >/dev/null
  echo "$1" > "$LAB_STATE/scenario"
  date +%s > "$LAB_STATE/started_at"
  echo
  cmd_ticket
  echo
  echo "When you think it's fixed: ./lab check"
}

cmd_ticket() {
  local name; name="$(current_scenario)"
  sed 's/^/  /' "$(scenario_dir "$name")/ticket.md"
}

# Ask the scenario's diagnosis questions. Returns non-zero if any answer is wrong.
run_quiz() {
  local file="$1" q="" answer="" reply line wrong=0
  [[ -f "$file" ]] || return 0
  echo
  echo "Diagnosis questions:"
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == "Q: "* ]]; then
      q="${line#Q: }"; echo; echo "  $q"
    elif [[ "$line" =~ ^[A-Z]\) ]]; then
      echo "    $line"
    elif [[ "$line" == ANSWER:* ]]; then
      answer="${line#ANSWER: }"
      read -r -p "  Your answer: " reply </dev/tty
      if [[ "${reply^^}" == "$answer" ]]; then pass "correct"; else fail "not quite (answer: $answer)"; wrong=1; fi
    fi
  done < "$file"
  return "$wrong"
}

cmd_check() {
  local name dir started elapsed result
  name="$(current_scenario)"; dir="$(scenario_dir "$name")"
  echo "Checking '$name'..."
  CHECK_FAILED=0
  # shellcheck source=/dev/null
  source "$dir/check.sh"
  if [[ "$CHECK_FAILED" -ne 0 ]]; then
    echo; echo "Not fixed yet. Keep going."; return 1
  fi

  result="fixed"
  if [[ -z "${LAB_NONINTERACTIVE:-}" ]]; then
    run_quiz "$dir/quiz.txt" || result="fixed, diagnosis incomplete"
  fi

  started="$(cat "$LAB_STATE/started_at")"
  elapsed=$(( $(date +%s) - started ))
  printf '\nResult: %s in %dm %02ds\n' "$result" $((elapsed / 60)) $((elapsed % 60))
  printf '%s\t%s\t%s\t%ss\n' "$(date -u +%FT%TZ)" "$name" "$result" "$elapsed" >> "$LAB_ROOT/results.log"
  echo "Logged to results.log. Write-up for this scenario: scenarios/$name/RUNBOOK.md"
}

# Used by CI to prove each scenario is fixable. Spoilers inside.
cmd_solve() {
  local name; name="$(current_scenario)"
  bash "$(scenario_dir "$name")/solution.sh"
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    list)   cmd_list ;;
    start)  cmd_start "$@" ;;
    check)  cmd_check ;;
    ticket) cmd_ticket ;;
    reset)  cmd_reset; rm -f "$LAB_STATE/scenario" ;;
    down)   compose --profile tools down -v --remove-orphans; rm -rf "$LAB_STATE" ;;
    wp)     wp "$@" ;;
    shell)  compose exec -u www-data wordpress bash ;;
    logs)   compose logs --tail=100 "$@" ;;
    _solve) cmd_solve ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
  esac
}

main "$@"
