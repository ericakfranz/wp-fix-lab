#!/usr/bin/env bash
# WP Fix Lab: break a real WordPress site in a realistic way, then prove you can fix it.
#
# Each error "type" is a generator, not a fixed puzzle. A seed picks one of several
# root causes and a set of red herrings, so the same type gives a different problem
# every run. The grader checks that the SITE actually works again, not that you ran
# a particular command - so fixing a red herring doesn't count.
set -euo pipefail

# shellcheck source=lib/common.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh"

# Echo instructions back in the same form the user launched us with: "./lab" when
# run directly, "bash lab" when run through bash (common from a downloaded ZIP,
# where the file isn't marked executable).
case "$0" in
  /*|./*|../*) LAB_CMD="$0" ;;
  *)           LAB_CMD="bash $0" ;;
esac
# Rewrite the literal "./lab" in scenario text (tickets, hints, quizzes, runbooks)
# to whatever form the user is actually using.
lab_say() { sed "s#\./lab#${LAB_CMD}#g"; }

usage() {
  cat <<EOF
WP Fix Lab

Usage: $LAB_CMD <command>

  list                       Show the error types you can be tested on
  start <type> [options]     Reset the site, break it, show the ticket
  check                      Grade your fix: PASS / FAIL
  ticket                     Show the current ticket again
  history                    Show your last 10 solved scenarios (time + seed)
  reset                      Rebuild a clean, working site
  down                       Stop everything and delete the lab's data

  start options:
    --test                   Test mode: ticket + PASS/FAIL only. No hints, no
                             runbook, no diagnosis questions. (Default is training.)
    --seed <n>               Reproduce an exact scenario (same seed = same problem).

Training-mode extras (not available with --test):
  hint                       One more nudge each time you ask.
  runbook                    Show the write-up for the current type.

Tools while you work:
  wp <args>                  Run WP-CLI (e.g. $LAB_CMD wp plugin list)
  shell                      Open a shell in the PHP container
  logs [service]             Container logs (wordpress, nginx, db)

Site: $LAB_URL   (admin / admin)
EOF
}

# ---- state -----------------------------------------------------------------
state_get() { cat "$LAB_STATE/$1" 2>/dev/null || true; }
current_type() {
  local t; t="$(state_get type)"
  [[ -n "$t" ]] || die "No scenario running. Try: $LAB_CMD list"
  echo "$t"
}
type_file() {
  local f="$LAB_ROOT/scenarios/$1/scenario.sh"
  [[ -f "$f" ]] || die "Unknown type '$1'. Try: $LAB_CMD list"
  echo "$f"
}

# Load a type's generator. Sets SCENARIO_TITLE, VARIANTS, and the
# break/fix/check/ticket/hint/quiz functions for the active run.
load_type() {
  local type="$1"
  VARIANTS=()
  # shellcheck source=/dev/null
  source "$(type_file "$type")"
  [[ ${#VARIANTS[@]} -gt 0 ]] || die "Type '$type' defines no variants."
}

# ---- commands --------------------------------------------------------------
cmd_list() {
  local d type
  for d in "$LAB_ROOT"/scenarios/*/; do
    type="$(basename "$d")"
    ( load_type "$type"; printf '  %-16s %-42s (%d variants)\n' "$type" "$SCENARIO_TITLE" "${#VARIANTS[@]}" )
  done
}

cmd_reset() {
  echo "Building a clean site..."
  compose --profile tools down -v --remove-orphans >/dev/null 2>&1 || true
  find "$LAB_ROOT/nginx/lab" -type f ! -name .gitkeep -delete
  rm -rf "$LAB_STATE"; mkdir -p "$LAB_STATE"
  compose up -d --wait >/dev/null

  local i
  for i in $(seq 1 60); do
    in_php 'test -f /var/www/html/wp-config.php' 2>/dev/null && break
    sleep 1
    [[ $i -eq 60 ]] && die "WordPress files never appeared. Check: $LAB_CMD logs wordpress"
  done

  wp core install --url="$LAB_URL" --title="WP Fix Lab" \
    --admin_user=admin --admin_password=admin --admin_email=admin@example.com \
    --skip-email >/dev/null
  wp rewrite structure '/%postname%/' >/dev/null
  wp post generate --count=8 >/dev/null 2>&1 || true

  [[ "$(http_code /)" == 200 ]] || die "Clean site isn't returning 200. Check: $LAB_CMD logs"
}

cmd_start() {
  local type="" seed="" mode="training"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --test)   mode="test" ;;
      --seed)   seed="${2:-}"; shift ;;
      --seed=*) seed="${1#--seed=}" ;;
      --*)      die "Unknown option '$1'" ;;
      *)        type="$1" ;;
    esac
    shift
  done
  [[ -n "$type" ]] || die "Usage: $LAB_CMD start <type> [--test] [--seed <n>]"
  [[ -z "$seed" || "$seed" =~ ^[0-9]+$ ]] || die "--seed takes a number."

  load_type "$type"
  local n=${#VARIANTS[@]} idx
  if [[ -n "$seed" ]]; then
    idx=$(( seed % n ))                 # explicit --seed: exact and repeatable
  else
    # No seed: pick a random scenario, and don't repeat the last one for this type,
    # so scenarios auto-rotate. The "last seen" marker lives beside the repo because
    # the .lab state folder is wiped on every start.
    local last_file="$LAB_ROOT/.lab-last-$type" last=-1
    [[ -f "$last_file" ]] && last="$(cat "$last_file" 2>/dev/null || echo -1)"
    for _ in $(seq 1 25); do
      seed=$(( RANDOM * 32768 + RANDOM ))   # a clean integer, well spread
      idx=$(( seed % n ))
      [[ "$n" -le 1 || "$idx" != "$last" ]] && break
    done
    echo "$idx" > "$last_file"
  fi
  export LAB_SEED="$seed" LAB_MODE="$mode"
  export LAB_VARIANT="${VARIANTS[$idx]}"

  cmd_reset
  echo "Breaking things..."
  apply_break >/dev/null

  printf '%s' "$type"        > "$LAB_STATE/type"
  printf '%s' "$seed"        > "$LAB_STATE/seed"
  printf '%s' "$mode"        > "$LAB_STATE/mode"
  printf '%s' "$LAB_VARIANT" > "$LAB_STATE/variant"
  date +%s > "$LAB_STATE/started_at"
  echo 0  > "$LAB_STATE/hints_used"

  echo
  if [[ "$mode" == test ]]; then
    printf '=== TEST MODE ===  type: %s   seed: %s\n\n' "$type" "$seed"
  else
    printf '=== TRAINING MODE ===  type: %s   seed: %s\n\n' "$type" "$seed"
  fi
  ticket | lab_say
  echo
  echo "When you think it's fixed:  $LAB_CMD check"
  if is_training; then echo "Stuck?  $LAB_CMD hint"; fi
  return 0
}

# Re-establish the running scenario's env before calling into its functions.
restore_run() {
  local type; type="$(current_type)"
  LAB_SEED="$(state_get seed)"; LAB_MODE="$(state_get mode)"; LAB_VARIANT="$(state_get variant)"
  export LAB_SEED LAB_MODE LAB_VARIANT
  load_type "$type"
}

cmd_ticket() { restore_run; ticket | lab_say | sed 's/^/  /'; }

cmd_hint() {
  restore_run
  is_training || die "Hints are off in test mode. Grade with: $LAB_CMD check"
  local used total
  used="$(state_get hints_used)"; total="$(hint_count)"
  if (( used >= total )); then
    echo "No more hints - you've seen all $total. The full write-up: $LAB_CMD runbook"
    return 0
  fi
  hint "$(( used + 1 ))" | lab_say
  echo "$(( used + 1 ))" > "$LAB_STATE/hints_used"
  echo
  printf '(hint %d of %d)\n' "$(( used + 1 ))" "$total"
}

cmd_runbook() {
  restore_run
  is_training || die "Runbooks are off in test mode."
  cat "$LAB_ROOT/scenarios/$(current_type)/RUNBOOK.md" | lab_say
}

run_quiz() {
  local line q="" answer reply wrong=0
  echo; echo "Diagnosis questions (so a lucky fix doesn't pass as understanding):"
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == "Q: "* ]]; then
      q="${line#Q: }"; echo; echo "  $q"
    elif [[ "$line" =~ ^[A-Z]\) ]]; then
      echo "    $line"
    elif [[ "$line" == ANSWER:* ]]; then
      answer="${line#ANSWER: }"
      read -r -p "  Your answer: " reply </dev/tty
      # Uppercase via tr (works on macOS bash 3.2, where ${reply^^} does not).
      reply="$(printf '%s' "$reply" | tr '[:lower:]' '[:upper:]')"
      if [[ "$reply" == "$answer" ]]; then pass "correct"; else fail "not quite (answer: $answer)"; wrong=1; fi
    fi
  done < <(quiz | lab_say)
  return "$wrong"
}

# Append one tab-separated record to the history log: when, type, mode, result,
# elapsed seconds, seed, hints. Read back by '$LAB_CMD history'.
log_attempt() {
  local result="$1" started now elapsed
  started="$(state_get started_at)"; now="$(date +%s)"
  elapsed=$(( now - ${started:-now} ))
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$(date -u +%FT%TZ)" "$(current_type)" "$(state_get mode)" "$result" "$elapsed" \
    "$(state_get seed)" "$(state_get hints_used)" >> "$LAB_ROOT/results.log"
}

cmd_check() {
  restore_run
  local type; type="$(current_type)"
  echo "Grading '$type' (variant hidden, seed $(state_get seed))..."
  echo
  CHECK_FAILED=0
  check
  echo
  if [[ "$CHECK_FAILED" -ne 0 ]]; then
    printf '\033[31mFAIL\033[0m - not fixed yet.\n'
    # Record the failed attempt once per scenario, so repeated checks don't pile up.
    if [[ ! -f "$LAB_STATE/logged_fail" ]]; then
      log_attempt "fail"; : > "$LAB_STATE/logged_fail"
    fi
    if is_training; then echo "Keep going. A nudge: $LAB_CMD hint"; fi
    echo "Recent attempts: $LAB_CMD history"
    return 1
  fi
  printf '\033[32mPASS\033[0m - the site is healthy again.\n'

  local result="pass"
  if is_training && [[ -z "${LAB_NONINTERACTIVE:-}" ]]; then
    run_quiz || result="pass (diagnosis incomplete)"
    echo; echo "Full write-up for this type: $LAB_CMD runbook"
  fi

  local started elapsed; started="$(state_get started_at)"; elapsed=$(( $(date +%s) - started ))
  printf '\nResult: %s in %dm %02ds  [mode: %s, seed: %s, hints: %s]\n' \
    "$result" $((elapsed/60)) $((elapsed%60)) "$(state_get mode)" "$(state_get seed)" "$(state_get hints_used)"
  log_attempt "$result"
  echo "Recent attempts: $LAB_CMD history"
}

# Show the last 10 solved scenarios, most recent first.
cmd_history() {
  local log="$LAB_ROOT/results.log"
  if [[ ! -s "$log" ]]; then
    echo "No attempts recorded yet. Solve one, then run: $LAB_CMD check"
    return 0
  fi
  echo "Last 10 attempts (most recent first):"
  echo
  printf '  %-16s  %-9s  %-8s  %-6s  %6s  %-12s  %s\n' WHEN TYPE MODE RESULT TIME SEED HINTS
  printf '  %-16s  %-9s  %-8s  %-6s  %6s  %-12s  %s\n' ---------------- --------- -------- ------ ------ ------------ -----
  # Keep only complete (7-field) records, then print the last 10 newest-first.
  awk -F'\t' 'NF>=7{a[++n]=$0} END{for(i=n;i>=1 && i>n-10;i--) print a[i]}' "$log" | \
  while IFS=$'\t' read -r ts type mode result elapsed seed hints; do
    when="${ts/T/ }"; when="${when%:*}"              # 2026-10-05 13:45
    mmss="$(printf '%d:%02d' $((elapsed/60)) $((elapsed%60)))"
    case "$result" in
      pass)  r=PASS ;;
      pass*) r="PASS*" ;;                            # passed, but missed a quiz question
      fail)  r=FAIL ;;                               # gave up / checked while still broken
      *)     r="$result" ;;
    esac
    printf '  %-16s  %-9s  %-8s  %-6s  %6s  %-12s  %s\n' "$when" "$type" "$mode" "$r" "$mmss" "$seed" "$hints"
  done
  echo
  echo "  Replay any of these exactly:  $LAB_CMD start <type> --seed <seed>"
  echo "  (PASS* = solved but missed a diagnosis question.  FAIL = checked while still broken.)"
}

# Apply the reference fix. Spoiler; used by CI to prove each scenario is fixable.
cmd_solve() { restore_run; fix; }

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    list)    cmd_list ;;
    start)   cmd_start "$@" ;;
    check)   cmd_check ;;
    ticket)  cmd_ticket ;;
    hint)    cmd_hint ;;
    runbook) cmd_runbook ;;
    history) cmd_history ;;
    reset)   cmd_reset; rm -rf "$LAB_STATE" ;;
    down)    compose --profile tools down -v --remove-orphans; rm -rf "$LAB_STATE" ;;
    wp)      wp "$@" ;;
    shell)   compose exec -u www-data wordpress bash ;;
    logs)    compose logs --tail=100 "$@" ;;
    _solve)  cmd_solve ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
  esac
}

main "$@"
